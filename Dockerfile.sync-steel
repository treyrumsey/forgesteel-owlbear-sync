# fs-web: Sync Steel's web app (the branded fork), served by nginx. Build from the repository root:
#   docker build -f Dockerfile.sync-steel .
# Upstream's own Dockerfile stays as it is; this one pins Node, honours .npmrc and builds with
# vite.sync-steel.config.ts. At startup nginx/env.sh replaces FORGESTEEL_* placeholders, such as
# FORGESTEEL_SYNC_STEEL_API_HOST, with the container's variables of the same names.

FROM node:26-slim AS builder
WORKDIR /app

COPY package.json package-lock.json .npmrc ./
RUN npm ci

# Only what the web build needs, not server/, obr-extension/ or docs/
COPY index.html tsconfig.json vite.config.ts vite.sync-steel.config.ts .env.production ./
COPY public ./public
COPY src ./src
RUN npx vite build --config vite.sync-steel.config.ts

# The Debian image, like upstream's: nginx/env.sh needs bash
FROM nginx:stable

RUN rm -rf /etc/nginx/conf.d/default.conf
COPY nginx/default.conf /etc/nginx/conf.d/default.conf

COPY --from=builder /app/dist /usr/share/nginx/html

COPY nginx/env.sh /docker-entrypoint.d/40-env.sh
RUN chmod +x /docker-entrypoint.d/40-env.sh

WORKDIR /usr/share/nginx/html

EXPOSE 80
ENTRYPOINT ["/docker-entrypoint.sh"]
CMD ["nginx", "-g", "daemon off;"]
